rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /dishes/{dishId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
