rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny everything outside explicit allow paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|jpg|png|webp|gif|avif)$');
    }

    // Recipe cover photos: public read, validated image uploads (<= 5MB)
    match /recipes/{fileName} {
      allow read: if true;
      allow create, update: if isValidImageUpload();
      allow delete: if true;
    }
  }
}
