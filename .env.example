# ==============================================================================
# Firebase Client Configuration (Vite / Vercel Environment Variables)
# Configure these in Vercel Project Settings -> Environment Variables.
# ==============================================================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# Optional: Leave as "(default)" for standard Firestore databases, or set custom database ID
VITE_FIREBASE_DATABASE_ID="(default)"

# Internal email mapped from the single admin username ("admin")
VITE_ADMIN_EMAIL="admin@myrecipe.local"

# ==============================================================================
# One-Time Admin Setup Script (LOCAL SECURE TERMINAL ONLY — NEVER SET IN VERCEL)
# ==============================================================================
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"
# ADMIN_EMAIL="admin@myrecipe.local"
# ADMIN_INITIAL_PASSWORD="SET_ONLY_WHEN_RUNNING_INIT_SCRIPT_LOCALLY"

# ==============================================================================
# AI Studio Runtime Defaults
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
